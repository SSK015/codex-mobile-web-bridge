# This repository contains a live private deployment beside its public source.
# Deny everything by default, then allow only reviewed open-source files.
/*

!/.gitignore
!/.gitattributes
!/.env.example
!/README.md
!/SECURITY.md
!/CONTRIBUTING.md
!/NOTICE.md
!/package.json
!/package-lock.json
!/server.mjs
!/app-server-client.mjs
!/rpc-multiplexer.mjs
!/desktop-app-tools-client.mjs
!/desktop-app-tools-discovery.mjs
!/desktop-controlled-app-server.mjs
!/sanitizers.mjs
!/turn-input.mjs

!/public/
!/public/**
!/assets/
!/assets/architecture.svg
!/assets/demo-conversation.png
!/assets/demo-task-list.png
!/assets/hero-continuity.gif
!/scripts/
!/scripts/**
!/docs/
!/docs/**
!/examples/
!/examples/**
!/test/
!/test/**

# A license will be explicitly selected before the first public release.
!/LICENSE
