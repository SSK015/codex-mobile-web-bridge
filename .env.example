# Required for authenticated access. The start scripts create this file when absent.
CODEX_MOBILE_SECRET_FILE=/path/to/private/state/secret.txt

# Optional. Defaults to codex.exe on Windows and codex elsewhere.
CODEX_MOBILE_CODEX_PATH=/path/to/your/installed/codex

# Optional advanced mode: connect to an already running App Server.
# CODEX_MOBILE_APP_SERVER_URL=ws://127.0.0.1:4512

# Recommended desktop/mobile mode: expose one local RPC multiplexer endpoint
# and configure Codex Desktop to connect to that endpoint, not directly to the
# App Server above.
# CODEX_MOBILE_RPC_MUX_LISTEN_URL=ws://127.0.0.1:4513

CODEX_MOBILE_HOST=127.0.0.1
CODEX_MOBILE_PORT=4780

# Set these when a reverse proxy exposes /codex-mobile/ over HTTPS.
# CODEX_MOBILE_SECURE_COOKIE=1
# CODEX_MOBILE_COOKIE_PATH=/codex-mobile/

# Optional state locations.
# CODEX_MOBILE_SEEN_FILE=/path/to/private/state/seen-threads.json
# CODEX_MOBILE_THREAD_LIST_CACHE_FILE=/path/to/private/state/thread-list-cache.json
# CODEX_MOBILE_UPLOAD_ROOT=/path/to/private/state/uploads
